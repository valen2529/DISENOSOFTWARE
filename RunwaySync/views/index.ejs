<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>RunwaySync</title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;}
    html,body{width:100%;height:100%;overflow:hidden;}
    body{background:#fafafa;}

    .page{
      width:100vw;
      height:100vh;
      display:grid;
      grid-template-columns:1fr 420px;
      overflow:hidden;
    }

    /* ── LADO IZQUIERDO ── */
    .left{
      position:relative;
      background:#fff;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      overflow:hidden;
    }

    .bg-img{
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:30% center;
    }

    /* franja roja decorativa arriba */
    .left::before{
      content:'';
      position:absolute;
      top:0; left:0; right:0;
      height:4px;
      background:#c0001a;
      z-index:2;
    }

    /* texto sobre imagen — zona derecha (área blanca) */
    .hero-text{
      position:absolute;
      bottom:48px;
      right:36px;
      z-index:5;
      display:flex;
      flex-direction:column;
      align-items:flex-end;
      text-align:right;
      max-width:52%;
    }
    .hero-tag{
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.62rem;
      letter-spacing:0.24em;
      text-transform:uppercase;
      color:#c0001a;
      font-weight:700;
      margin-bottom:8px;
    }
    .hero-divider{
      width:32px;height:2px;
      background:#c0001a;border-radius:2px;
      margin-bottom:10px;
      align-self:flex-end;
    }
    .hero-headline{
      font-family:'Georgia',serif;
      font-size:1.65rem;
      color:#141516;
      line-height:1.3;
      font-weight:700;
    }
    .hero-headline em{
      font-style:normal;
      color:#c0001a;
    }
    .hero-sub{
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.74rem;
      color:#5a5a5a;
      margin-top:8px;
      line-height:1.65;
    }

    /* ── LADO DERECHO ── */
    .right{
      background:#c0001a;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      padding:48px 44px;
    }

    .form-label-top{
      font-family:'Georgia',serif;
      font-size:1.05rem;
      color:rgba(255,255,255,0.6);
      letter-spacing:0.18em;
      text-transform:uppercase;
      margin-bottom:6px;
      align-self:flex-start;
    }
    .form-title{
      font-family:'Georgia',serif;
      font-size:2rem;
      font-weight:700;
      color:#ffffff;
      margin-bottom:32px;
      align-self:flex-start;
      line-height:1.1;
    }

    .input-box{
      width:100%;
      background:rgba(255,255,255,0.12);
      border-radius:12px;
      padding:12px 18px 10px;
      margin-bottom:12px;
      border:1.5px solid rgba(255,255,255,0.15);
      transition:border 0.2s, background 0.2s;
    }
    .input-box:focus-within{
      border-color:rgba(255,255,255,0.6);
      background:rgba(255,255,255,0.18);
    }
    .input-label{
      display:block;
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.68rem;
      font-weight:700;
      color:rgba(255,255,255,0.55);
      letter-spacing:0.1em;
      text-transform:uppercase;
      margin-bottom:4px;
    }
    .input-field{
      width:100%;
      border:none;
      outline:none;
      background:transparent;
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.92rem;
      color:#ffffff;
    }
    .input-field::placeholder{color:rgba(255,255,255,0.3);}

    .field-error{
      display:none;
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.72rem;
      color:rgba(255,255,255,0.8);
      margin-top:-8px;
      margin-bottom:8px;
      padding-left:4px;
    }
    .field-error.visible{display:block;}

    .forgot-row{
      width:100%;
      text-align:right;
      margin-bottom:4px;
      margin-top:-4px;
    }
    .forgot-link{
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.76rem;
      color:rgba(255,255,255,0.6);
      text-decoration:none;
    }
    .forgot-link:hover{color:#fff;}

    .btn-main{
      width:100%;
      height:50px;
      background:#ffffff;
      color:#c0001a;
      font-family:'Georgia',serif;
      font-size:1rem;
      font-weight:700;
      border:none;
      cursor:pointer;
      border-radius:50px;
      letter-spacing:0.06em;
      margin-top:22px;
      display:flex;align-items:center;justify-content:center;
      box-shadow:0 4px 20px rgba(0,0,0,0.18);
      transition:background 0.2s, transform 0.15s;
    }
    .btn-main:hover{background:#f5f5f5;transform:translateY(-1px);}
    .btn-main:disabled{background:rgba(255,255,255,0.4);color:#fff;cursor:not-allowed;transform:none;}

    .btn-main .spinner{
      display:none;
      width:17px;height:17px;
      border:2px solid rgba(192,0,26,0.3);
      border-top-color:#c0001a;
      border-radius:50%;
      animation:spin 0.7s linear infinite;
      margin-right:8px;
    }
    .btn-main.loading .spinner{display:block;}
    .btn-main.loading .btn-text{opacity:0.7;}
    @keyframes spin{to{transform:rotate(360deg);}}

    .server-error{
      width:100%;
      background:rgba(0,0,0,0.2);
      border:1px solid rgba(255,255,255,0.25);
      color:#fecaca;
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.78rem;
      border-radius:10px;
      padding:9px 14px;
      margin-bottom:12px;
      text-align:center;
    }

    .footer-note{
      margin-top:24px;
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.65rem;
      color:rgba(255,255,255,0.35);
      letter-spacing:0.10em;
      text-transform:uppercase;
      text-align:center;
    }

    .toast{
      position:fixed;
      top:20px;left:50%;transform:translateX(-50%) translateY(-10px);
      background:#7f0010;color:#fff;
      padding:10px 22px;border-radius:50px;
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.82rem;font-weight:600;
      box-shadow:0 4px 20px rgba(0,0,0,0.25);
      z-index:999;opacity:0;
      transition:opacity 0.25s ease, transform 0.25s ease;
      pointer-events:none;
    }
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  </style>
</head>
<body>
<div class="page">

  <!-- Lado izquierdo: imagen + texto -->
  <div class="left">
    <img class="bg-img" src="/img/RunwaySync.png" alt="RunwaySync"/>

    <div class="hero-text">
      <p class="hero-tag">Fashion Management Platform</p>
      <div class="hero-divider"></div>
      <h1 class="hero-headline">Del moodboard al <em>showroom.</em></h1>
      <p class="hero-sub">Coordina colecciones, sesiones y equipo en un solo lugar.<br/>Siempre sincronizados.</p>
    </div>
  </div>

  <!-- Lado derecho: formulario rojo -->
  <div class="right">
    <p class="form-label-top">Bienvenido/a</p>
    <h2 class="form-title">Iniciar<br/>Sesión</h2>

    <%
      const _err = (typeof error !== 'undefined') ? error : null;
      const _errId = _err && (_err.includes('usuario') || _err.includes('Usuario')) ? _err : null;
      const _errPw = _err && (_err.includes('ontraseña') || _err.includes('contraseña')) ? _err : null;
      const _errGen = _err && !_errId && !_errPw ? _err : null;
    %>
    <% if (_errGen) { %>
      <div class="server-error"><%= _errGen %></div>
    <% } %>

    <form id="loginForm" action="/login" method="POST" novalidate style="width:100%">

      <div class="input-box" id="box-id">
        <label class="input-label" for="empresarial-id">ID Empresarial</label>
        <input
          type="text"
          id="empresarial-id"
          name="id_empresarial"
          class="input-field"
          placeholder="11.00.095.532"
          autocomplete="username"
        />
      </div>
      <span class="field-error<% if (_errId) { %> visible<% } %>" id="err-id"><% if (_errId) { %>El ID Empresarial no es correcto.<% } %></span>

      <div class="input-box" id="box-pw">
        <label class="input-label" for="password">Contraseña</label>
        <input
          type="password"
          id="password"
          name="password"
          class="input-field"
          placeholder="••••••••••••••••"
          autocomplete="current-password"
        />
      </div>
      <span class="field-error<% if (_errPw) { %> visible<% } %>" id="err-pw"><% if (_errPw) { %>La contraseña no es correcta.<% } %></span>

      <div class="forgot-row">
        <a href="/recuperar" class="forgot-link">¿Olvidaste tu contraseña?</a>
      </div>

      <button type="submit" class="btn-main" id="btnLogin">
        <span class="spinner"></span>
        <span class="btn-text">Iniciar Sesión</span>
      </button>

    </form>

    <p class="footer-note">Acceso exclusivo para miembros del equipo</p>
  </div>

</div>
<div class="toast" id="toast"></div>
<script>
  const form    = document.getElementById('loginForm');
  const idInput = document.getElementById('empresarial-id');
  const pwInput = document.getElementById('password');
  const boxId   = document.getElementById('box-id');
  const boxPw   = document.getElementById('box-pw');
  const errId   = document.getElementById('err-id');
  const errPw   = document.getElementById('err-pw');
  const btn     = document.getElementById('btnLogin');
  const toast   = document.getElementById('toast');

  function showMsg(err,msg){err.textContent=msg;err.classList.add('visible');}
  function clearMsg(err){err.textContent='';err.classList.remove('visible');}
  function showToast(msg){toast.textContent=msg;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),3500);}

  const ID_PATTERN=/^\d{2}\.\d{2}\.\d{3}\.\d{3}$/;

  function validateId(){
    const val=idInput.value.trim();
    if(!val){showMsg(errId,'El ID Empresarial es obligatorio.');return false;}
    if(!ID_PATTERN.test(val)){showMsg(errId,'Formato inválido. Usa: 11.00.095.532');return false;}
    clearMsg(errId);return true;
  }
  function validatePassword(){
    const val=pwInput.value;
    if(!val){showMsg(errPw,'La contraseña es obligatoria.');return false;}
    if(val.length<6){showMsg(errPw,'Debe tener al menos 6 caracteres.');return false;}
    clearMsg(errPw);return true;
  }

  idInput.addEventListener('blur',validateId);
  pwInput.addEventListener('blur',validatePassword);
  idInput.addEventListener('input',()=>clearMsg(errId));
  pwInput.addEventListener('input',()=>clearMsg(errPw));

  form.addEventListener('submit',function(e){
    e.preventDefault();
    const idEmpty=!idInput.value.trim();
    const pwEmpty=!pwInput.value;
    const idOk=validateId();
    const pwOk=validatePassword();
    if(!idOk&&!pwOk){
      if(idEmpty&&pwEmpty){showToast('Los campos están vacíos.');}
      else{showToast('El ID Empresarial y la contraseña no son válidos.');}
      return;
    }
    if(!idOk||!pwOk){return;}
    btn.disabled=true;btn.classList.add('loading');
    setTimeout(()=>{btn.disabled=false;btn.classList.remove('loading');form.submit();},800);
  });
</script>
</body>
</html>
