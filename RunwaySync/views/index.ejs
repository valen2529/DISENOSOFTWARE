<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>RunwaySync</title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;}
    html,body{width:100%;height:100%;overflow:hidden;}
    body{background:#000;}

    .page{
      position:relative;
      width:100vw;
      height:100vh;
      overflow:hidden;
      display:flex;
      align-items:center;
      justify-content:flex-end;
    }

    .bg-img{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:contain;
      object-position:center center;
      z-index:1;
    }

    .overlay{
      position:absolute;
      inset:0;
      background:linear-gradient(
        to right,
        rgba(0,0,0,0.05) 0%,
        rgba(0,0,0,0.55) 100%
      );
      z-index:2;
    }

    /* ── CARD ── */
    .card-overlay{
      position:relative;
      z-index:10;
      background:rgba(217,217,217,0.97);
      border-radius:22px;
      width:420px;
      padding:40px 46px 34px;
      box-shadow:0 8px 40px rgba(0,0,0,0.25);
      margin-right:7vw;
    }

    .card-title{
      font-family:'Georgia',serif;
      font-size:2rem;
      font-weight:700;
      color:#141516;
      text-align:center;
      margin-bottom:6px;
      letter-spacing:0.01em;
    }
    /* ── TEXTO FLOTANTE SOBRE LA IMAGEN ── */
    .hero-text{
      position:absolute;
      z-index:10;
      bottom:60px;
      left:52px;
      max-width:340px;
    }
    .hero-tagline{
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.72rem;
      color:rgba(255,255,255,0.65);
      letter-spacing:0.18em;
      text-transform:uppercase;
      margin-bottom:10px;
    }
    .hero-divider{
      width:36px;height:2px;
      background:#cd1b1b;border-radius:2px;
      margin-bottom:14px;
    }
    .hero-copy{
      font-family:'Georgia',serif;
      font-size:1.45rem;
      color:#ffffff;
      line-height:1.5;
      font-weight:400;
      text-shadow:0 2px 12px rgba(0,0,0,0.35);
    }
    .hero-copy strong{
      font-weight:700;
      color:#ffffff;
    }

    .input-box{
      background:#ffffff;
      border-radius:14px;
      padding:12px 18px 10px;
      margin-bottom:14px;
      transition:box-shadow 0.2s, border 0.2s;
      border:2px solid transparent;
    }
    .input-box.error{
      border:2px solid #ff3131;
      box-shadow:0 0 0 3px rgba(255,49,49,0.12);
    }
    .input-box.success{
      border:2px solid #08b864;
      box-shadow:0 0 0 3px rgba(8,184,100,0.10);
    }
    .input-label{
      display:block;
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.88rem;
      font-weight:700;
      color:#231f20;
      margin-bottom:2px;
    }
    .input-field{
      width:100%;
      border:none;
      outline:none;
      background:transparent;
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.88rem;
      color:#95a2a5;
    }
    .input-field::placeholder{color:#95a2a5;}

    .field-error{
      display:none;
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.74rem;
      color:#ff3131;
      margin-top:-10px;
      margin-bottom:10px;
      padding-left:4px;
    }
    .field-error.visible{display:block;}

    .forgot-row{
      text-align:right;
      margin-bottom:4px;
      margin-top:-4px;
    }
    .forgot-link{
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.8rem;
      color:#004aad;
      text-decoration:none;
    }
    .forgot-link:hover{text-decoration:underline;}

    .btn-main{
      display:flex;
      align-items:center;
      justify-content:center;
      width:100%;
      height:52px;
      background:#141516;
      color:#ffffff;
      font-family:'Georgia',serif;
      font-size:1.05rem;
      font-weight:700;
      border:none;
      cursor:pointer;
      border-radius:50px;
      letter-spacing:0.02em;
      margin:20px 0 0;
      box-shadow:0 4px 16px rgba(0,0,0,0.22);
      transition:background 0.2s, transform 0.15s;
    }
    .btn-main:hover{background:#333;transform:translateY(-1px);}
    .btn-main:disabled{background:#9ca3af;cursor:not-allowed;transform:none;box-shadow:none;}

    .btn-main .spinner{
      display:none;
      width:18px;height:18px;
      border:2px solid rgba(255,255,255,0.4);
      border-top-color:#fff;
      border-radius:50%;
      animation:spin 0.7s linear infinite;
      margin-right:8px;
    }
    .btn-main.loading .spinner{display:block;}
    .btn-main.loading .btn-text{opacity:0.7;}
    @keyframes spin{to{transform:rotate(360deg);}}

    <% if (typeof error !== 'undefined' && error) { %>
    /* server error shown on load */
    <% } %>

    .server-error{
      background:#fff0f0;
      border:1px solid #ffb3b3;
      color:#cc0000;
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.78rem;
      border-radius:10px;
      padding:9px 14px;
      margin-bottom:14px;
      text-align:center;
    }

    .toast{
      position:fixed;
      top:20px;left:50%;transform:translateX(-50%) translateY(-10px);
      background:#ff3131;color:#fff;
      padding:10px 22px;border-radius:50px;
      font-family:'Helvetica Neue',Arial,sans-serif;
      font-size:0.82rem;font-weight:600;
      box-shadow:0 4px 20px rgba(0,0,0,0.22);
      z-index:999;opacity:0;
      transition:opacity 0.25s ease, transform 0.25s ease;
      pointer-events:none;
    }
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  </style>
</head>
<body>
<div class="page">

  <img class="bg-img" src="/img/runway.jpeg" alt="RunwaySync"/>
  <div class="overlay"></div>

  <!-- Texto flotante izquierda -->
  <div class="hero-text">
    <p class="hero-tagline">Fashion Management Platform</p>
    <div class="hero-divider"></div>
    <p class="hero-copy">Coordina <strong>colecciones,<br/>sesiones y equipo</strong><br/>en un solo lugar.</p>
  </div>

  <div class="card-overlay">
    <h2 class="card-title">Iniciar Sesión</h2>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="server-error"><%= error %></div>
    <% } %>

    <form id="loginForm" action="/login" method="POST" novalidate>

      <div class="input-box" id="box-id">
        <label class="input-label" for="empresarial-id">ID Empresarial</label>
        <input
          type="text"
          id="empresarial-id"
          name="id_empresarial"
          class="input-field"
          placeholder="11.00.095.532"
          autocomplete="username"
        />
      </div>
      <span class="field-error" id="err-id"></span>

      <div class="input-box" id="box-pw">
        <label class="input-label" for="password">Contraseña</label>
        <input
          type="password"
          id="password"
          name="password"
          class="input-field"
          placeholder="****************"
          autocomplete="current-password"
        />
      </div>
      <span class="field-error" id="err-pw"></span>

      <div class="forgot-row">
        <a href="/recuperar" class="forgot-link">¿Olvidaste tu contraseña?</a>
      </div>

      <button type="submit" class="btn-main" id="btnLogin">
        <span class="spinner"></span>
        <span class="btn-text">Iniciar Sesión</span>
      </button>

    </form>
  </div>

  <div class="toast" id="toast"></div>
</div>
<script>
  const form    = document.getElementById('loginForm');
  const idInput = document.getElementById('empresarial-id');
  const pwInput = document.getElementById('password');
  const boxId   = document.getElementById('box-id');
  const boxPw   = document.getElementById('box-pw');
  const errId   = document.getElementById('err-id');
  const errPw   = document.getElementById('err-pw');
  const btn     = document.getElementById('btnLogin');
  const toast   = document.getElementById('toast');

  const ID_PATTERN = /^\d{2}\.\d{2}\.\d{3}\.\d{3}$/;

  function setError(box, err, msg){
    box.classList.add('error'); box.classList.remove('success');
    err.textContent = msg; err.classList.add('visible');
  }
  function setSuccess(box, err){
    box.classList.remove('error'); box.classList.add('success');
    err.classList.remove('visible');
  }
  function clearState(box, err){
    box.classList.remove('error','success'); err.classList.remove('visible');
  }
  function showToast(msg){
    toast.textContent = msg; toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3500);
  }

  function validateId(){
    const val = idInput.value.trim();
    if (!val){ setError(boxId, errId, 'El ID Empresarial es obligatorio.'); return false; }
    if (!ID_PATTERN.test(val)){ setError(boxId, errId, 'Formato inválido. Usa: 11.00.095.532'); return false; }
    setSuccess(boxId, errId); return true;
  }
  function validatePassword(){
    const val = pwInput.value;
    if (!val){ setError(boxPw, errPw, 'La contraseña es obligatoria.'); return false; }
    if (val.length < 6){ setError(boxPw, errPw, 'Debe tener al menos 6 caracteres.'); return false; }
    setSuccess(boxPw, errPw); return true;
  }

  idInput.addEventListener('blur', validateId);
  pwInput.addEventListener('blur', validatePassword);
  idInput.addEventListener('input', () => { if(boxId.classList.contains('error')) clearState(boxId, errId); });
  pwInput.addEventListener('input', () => { if(boxPw.classList.contains('error')) clearState(boxPw, errPw); });

  form.addEventListener('submit', function(e){
    e.preventDefault();
    if (!validateId() | !validatePassword()){
      showToast('Por favor corrige los campos en rojo.');
      return;
    }
    btn.disabled = true; btn.classList.add('loading');
    setTimeout(() => { btn.disabled = false; btn.classList.remove('loading'); form.submit(); }, 800);
  });
</script>
</body>
</html>
